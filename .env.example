# API server bind address + port (required)
API_ADDR=127.0.0.1
API_PORT=8080

# PostgreSQL connection string (required) — shared with the PHP legacy app
DATABASE_URL=postgres://beehive_user:CHANGE_ME@localhost:5432/beehive_vault

# Shared bearer token validated by the BearerAuth middleware on every /v1/*
# request. Format convention: bhv_<env>_<hex-32>. Generate with:
#   echo "bhv_dev_$(openssl rand -hex 32)"
# Healthchecks (/healthz, /readyz) are exempted. Required.
API_KEY=bhv_dev_replace_with_openssl_rand_hex_32

# Comma-separated CORS origins. Production MUST override to https://... only.
# Defaults to http://beehive-vault.fr,http://localhost:3000 when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Price-batch scheduler toggle. Set to false in dev/CI to avoid hitting Yahoo
# three times a day on every process launch. Defaults to true (enabled).
PRICE_SCHEDULER_ENABLED=false
