# HTTP server address. Defaults to 127.0.0.1:8080.
APP_BIND_ADDRESS=127.0.0.1:8080

# PostgreSQL connection string (required). Local Homebrew setup trusts localhost.
DATABASE_URL=postgres://beehive_vault@127.0.0.1:5432/beehive_vault
TEST_DATABASE_URL=postgres://beehive_vault@127.0.0.1:5432/beehive_vault_test

# Maximum size of the PostgreSQL connection pool. Defaults to 5.
DATABASE_MAX_CONNECTIONS=5

# Log filter used by tracing-subscriber.
RUST_LOG=beehive_vault_api=debug,tower_http=debug
